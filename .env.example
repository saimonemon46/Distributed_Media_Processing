# =====================================================================
# Distributed Media Processing Engine - Environment Configuration
# =====================================================================
# Copy this file to .env and adjust values for your environment.
# =====================================================================

# ---------------------------------------------------------------------
# PostgreSQL Configuration
# ---------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=media_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/media_db

# ---------------------------------------------------------------------
# MinIO / S3 Object Storage Configuration
# ---------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_NAME=media-bucket
# Internal endpoint used by Docker containers
MINIO_ENDPOINT=http://minio:9000
# External endpoint used for browser-accessible presigned download URLs
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ---------------------------------------------------------------------
# RabbitMQ Message Broker Configuration
# ---------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=media_processing_jobs

# ---------------------------------------------------------------------
# Application Configuration
# ---------------------------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
PREFETCH_COUNT=1
MAX_IMAGE_DIMENSION=500
PRESIGNED_URL_EXPIRATION_SECONDS=3600
